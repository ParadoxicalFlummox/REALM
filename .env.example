# ── Database ──────────────────────────────────────────────────────────────────
# Use "db" as the host when running via Docker Compose.
# Use "localhost" for manual / local dev.
DATABASE_URL=postgresql://your_user:your_password@db:5432/your_db

DB_USER=your_user
DB_PASSWORD=your_password
DB_NAME=your_db

# ── Backend ───────────────────────────────────────────────────────────────────
# Comma-separated allowed CORS origins.
# Dev (no Docker): http://localhost:5173
# Docker: not needed (nginx proxies internally), but set to your host if required.
CORS_ORIGINS=http://localhost:5173

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# Display name shown in the app header.
VITE_COMPANY_NAME=Your Company Name

# Backend API base URL.
# Dev:    http://localhost:8000
# Docker: /api  (nginx proxies /api/ to the backend container)
VITE_API_URL=http://localhost:8000
